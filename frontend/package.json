{
  "name": "robots-scheduler-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:pm": "pnpm --filter @robots/pm dev",
    "dev:om": "pnpm --filter @robots/om dev",
    "dev": "pnpm dev:pm & pnpm dev:om",
    "build:pm": "pnpm --filter @robots/pm build",
    "build:om": "pnpm --filter @robots/om build",
    "build": "pnpm build:pm && pnpm build:om",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.15.0"
}
