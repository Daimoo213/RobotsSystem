# Local Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Dependency installations
node_modules/

# Local service manager state and durable runtime logs
manager/runtime/

# Locally generated deployment secrets
deploy/.env
deploy/backups/
deploy/.images-loaded.sha256
deploy/images.tar

# Generated portable deployment bundles
release/
release-test/
release-validation/
release-validation-package/

# Local assistant/editor state and extracted document scratch data
.codebuddy/settings.local.json
.workbuddy/
unpacked_docx/

# Local environment and build output
backend/.env
frontend/apps/*/.env
frontend/apps/*/dist/

# Legacy and manually captured local server logs
*.log

# One-off root-level document inspection scripts
/_dump_check.py
/_read_doc.py
/_tmp_read*.py
/_verify_*.py

# Early project research and generated office documents stay local only.
# This rule applies only to the repository root; implementation manuals in docs/ remain tracked.
/*.docx
/*.xlsx

# Operating system file metadata
.DS_Store
Thumbs.db
